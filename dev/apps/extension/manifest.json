{
  "manifest_version": 3,
  "name": "LiMBo",
  "version": "0.1.1",
  "action": { "default_popup": "src/popup/index.html", "default_title": "LiMBo" },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "permissions": ["storage", "tabs", "alarms", "cookies"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "*://127.0.0.1:4567/*"
  ]
}
