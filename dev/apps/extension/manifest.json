{
  "manifest_version": 3,
  "name": "LiMBo",
  "version": "0.2.0",
  "description": "Téléchargeur vidéo local LiMBo — formats, trim et file via le Desktop Windows.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "LiMBo",
    "default_icon": {
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "permissions": ["storage", "tabs", "alarms", "cookies"],
  "browser_specific_settings": {
    "gecko": {
      "id": "limbo@darkchylde.local",
      "strict_min_version": "115.0"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:4567/*",
    "ws://127.0.0.1:4567/*"
  ]
}
