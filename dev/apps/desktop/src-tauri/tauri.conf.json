{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiMBo",
  "version": "0.3.1",
  "identifier": "com.limbo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
    "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiMBo",
        "width": 440,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,AudioServiceSandbox,WASAPIRawAudioCapture --disable-gpu --disable-gpu-compositing --disable-audio-output --mute-audio"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis_hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["limbo"]
      }
    }
  }
}
